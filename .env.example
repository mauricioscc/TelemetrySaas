# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
HOST=127.0.0.1

# Use "memory" to run without MongoDB, or "mongodb" to persist telemetry.
TELEMETRY_STORAGE=memory

# MongoDB configuration (used only when TELEMETRY_STORAGE=mongodb)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=telemetry_saas
MONGO_COLLECTION_NAME=vehicle_telemetry
